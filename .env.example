# Supabase public browser configuration
# Create a local .env file from this template. Never put service-role keys in Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional Google Maps JavaScript API browser key for interactive tracking map
# Keep the key restricted to your domains and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY
